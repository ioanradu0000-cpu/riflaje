{
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=optional --no-audit",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/produse/(.*)",
      "destination": "/"
    },
    {
      "source": "/cerere-oferta",
      "destination": "/"
    },
    {
      "source": "/colectii-riflaje",
      "destination": "/"
    },
    {
      "source": "/colectii/(.*)",
      "destination": "/"
    },
    {
      "source": "/cos",
      "destination": "/"
    },
    {
      "source": "/comanda",
      "destination": "/"
    },
    {
      "source": "/comanda/confirmare",
      "destination": "/"
    }
  ]
}
