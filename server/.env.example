PORT=4000
ADMIN_USER=admin

# Generate a hash with:
# node -e "import('bcryptjs').then(b=>console.log(b.hashSync('parola-ta', 10)))"
ADMIN_PASSWORD_HASH=$2b$10$replace_with_a_real_bcrypt_hash

# Use a long random value in production.
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development

# Domeniile care pot accesa backendul, separate prin virgula.
# Exemplu:
# CORS_ORIGINS=https://siteul-tau.ro,https://admin.siteul-tau.ro,https://proiect-client.vercel.app,https://proiect-admin.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Pentru frontend separat pe alt domeniu, in productie foloseste:
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
